# Viswah Environment Variables

# ⚠️ WARNING: Change these before deploying to production!
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"

# JWT Secret - REQUIRED
JWT_SECRET_KEY=viswah-dev-secret-change-in-production-2024

# OpenAI API Key - Get from https://platform.openai.com/api-keys
# Leave empty or as placeholder to use fallback lessons
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./viswah.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080