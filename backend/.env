# Viswah Environment Variables

# JWT Secret - Generate a real secret for production!
JWT_SECRET_KEY=viswah-dev-secret-change-in-production-2024

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Database
DATABASE_URL=sqlite:///./viswah.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080