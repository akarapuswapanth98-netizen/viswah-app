# Viswah Backend - Environment Variables
# Copy this file to .env and fill in values

# JWT Secret - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./viswah.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
